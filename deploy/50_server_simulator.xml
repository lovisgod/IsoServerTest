<server class="org.jpos.q2.iso.QServer" logger="Q2"
        name="com.lovisgod.tranctiontest-9009" realm="com.lovisgod.tranctiontest-9009">
    <attr name="port" type="java.lang.Integer">9009</attr>
    <channel class="org.jpos.iso.channel.PostChannel"
             packager="org.jpos.iso.packager.GenericPackager"
             type="server"
             logger="Q2"
             realm="com.lovisgod.tranctiontest-9009">
        <property name="timeout" value="180000"/>
        <property name="packager-config"
                  value="cfg/packager/postpack.xml"/>
    </channel>
    <request-listener class="org.jpos.iso.IncomingListener" logger="Q2"
                      realm="incoming-request-listener">
        <property name="queue" value="TXNMGR"/>

        <property name="ctx.DESTINATION" value="nibss_mux"/>
        <property name="timeout" value="50000"/>

    </request-listener>
</server>